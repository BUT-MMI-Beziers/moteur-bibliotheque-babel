{
    "name": "but-mmi-beziers/babel-moteur",
    "description": "Moteur de la Bibliothèque de Babel : permutation à clé entre adresses et pages de 3 200 caractères, avec intégration Laravel.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "babel",
        "bibliotheque",
        "borges",
        "laravel",
        "gmp",
        "feistel"
    ],
    "homepage": "https://github.com/BUT-MMI-Beziers/moteur-bibliotheque-babel",
    "support": {
        "issues": "https://github.com/BUT-MMI-Beziers/moteur-bibliotheque-babel/issues",
        "source": "https://github.com/BUT-MMI-Beziers/moteur-bibliotheque-babel"
    },
    "require": {
        "php": "^8.2",
        "ext-gmp": "*",
        "ext-hash": "*",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^11.5.3 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "Babel\\Moteur\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Babel\\Moteur\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Babel\\Moteur\\Laravel\\MoteurServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress --memory-limit=1G",
        "style": "pint --test",
        "formater": "pint",
        "bench": "@php outils/banc.php",
        "vecteurs:embarquer": "@php outils/embarquer-vecteurs.php",
        "qualite": [
            "@style",
            "@analyse",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Lance toute la suite PHPUnit (vecteurs, propriétés, robustesse, clé, Laravel).",
        "analyse": "Analyse statique PHPStan au niveau maximal.",
        "style": "Vérifie le formatage (Pint, PSR-12).",
        "formater": "Corrige le formatage (Pint, PSR-12).",
        "bench": "Banc d'essai : 300 allers-retours, médiane, 95e centile et maximum.",
        "vecteurs:embarquer": "Régénère resources/verification.json à partir de tests/donnees/vecteurs.json.",
        "qualite": "Style, analyse statique et tests."
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
